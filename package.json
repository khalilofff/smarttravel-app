{
  "name": "ai-travel-planner",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "full:start": "npm install && npm run setup1 && npm run dev",
    "setup": "npx prisma generate && npx prisma db push --force-reset && npx tsx prisma/seed.ts",
    "postinstall": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:reset": "npx prisma generate && npx prisma db push --force-reset && npx tsx prisma/seed.ts",
    "audit:check": "npm audit",
    "clean:install": "rd /s /q node_modules 2>nul & del package-lock.json 2>nul & npm install",
    "dev:admin": "node scripts/dev-local.mjs 3000 smarttravel-admin localhost",
    "dev:user": "node scripts/dev-local.mjs 3001 smarttravel-user localhost",
    "dev:manager": "node scripts/dev-local.mjs 3002 smarttravel-manager localhost",
    "import:places": "tsx scripts/import-geoapify-places.ts",
    "setup1": "node scripts/clean-sqlite-db.mjs && npx prisma generate && npx prisma db push --force-reset && npx tsx prisma/seed.ts",
    "ollama:check": "node scripts/check-ollama.mjs",
    "setup2": "npm run import:places",
    "repair": "npx prisma generate && npx prisma db push",
    "dev:lan": "next dev -H 0.0.0.0",
    "check": "tsc --noEmit",
    "persistent:setup": "node scripts/clean-sqlite-db.mjs && npx prisma generate && npx prisma db push --force-reset && npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jspdf": "3.0.4",
    "jspdf-autotable": "5.0.2",
    "lucide-react": "^0.554.0",
    "next": "14.2.35",
    "next-auth": "4.24.14",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.68.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.5.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.12",
    "nodemailer": "^7.0.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "@types/nodemailer": "^6.4.17"
  }
}
